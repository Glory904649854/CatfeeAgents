<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="200dp"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_agent_overlay"
    android:gravity="center_vertical"
    android:orientation="vertical"
    android:paddingStart="11dp"
    android:paddingTop="8dp"
    android:paddingEnd="7dp"
    android:paddingBottom="8dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <View
            android:id="@+id/overlay_dot"
            android:layout_width="6dp"
            android:layout_height="6dp"
            android:layout_marginEnd="7dp"
            android:background="@drawable/bg_agent_overlay_dot" />

        <TextView
            android:id="@+id/overlay_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:ellipsize="end"
            android:fontFamily="sans-serif-medium"
            android:maxLines="1"
            android:text="Step 0 · 准备中"
            android:textColor="#F8FAFC"
            android:textSize="10.5sp" />

        <TextView
            android:id="@+id/overlay_time"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="5dp"
            android:fontFeatureSettings="tnum"
            android:text="00:00"
            android:textColor="#94A3B8"
            android:textSize="9.5sp" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/overlay_detail"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="等待模型…"
            android:textColor="#B6C2D2"
            android:textSize="9sp" />

        <TextView
            android:id="@+id/overlay_pause"
            android:layout_width="25dp"
            android:layout_height="25dp"
            android:layout_marginStart="5dp"
            android:background="@drawable/bg_agent_overlay_button"
            android:clickable="true"
            android:focusable="false"
            android:gravity="center"
            android:text="Ⅱ"
            android:textColor="#E5E7EB"
            android:textSize="9sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/overlay_stop"
            android:layout_width="25dp"
            android:layout_height="25dp"
            android:layout_marginStart="3dp"
            android:background="@drawable/bg_agent_overlay_stop"
            android:clickable="true"
            android:focusable="false"
            android:gravity="center"
            android:text="×"
            android:textColor="#FF9AA2"
            android:textSize="14sp"
            android:textStyle="bold" />
    </LinearLayout>
</LinearLayout>
