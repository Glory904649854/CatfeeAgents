<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="300dp"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_agent_overlay"
    android:orientation="vertical"
    android:paddingStart="10dp"
    android:paddingTop="10dp"
    android:paddingEnd="10dp"
    android:paddingBottom="10dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <View
            android:id="@+id/overlay_dot"
            android:layout_width="10dp"
            android:layout_height="10dp"
            android:layout_marginEnd="10dp"
            android:background="@drawable/bg_agent_overlay_dot" />

        <TextView
            android:id="@+id/overlay_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:ellipsize="end"
            android:fontFamily="sans-serif-medium"
            android:maxLines="1"
            android:text="操作中 · 第 0/0 步"
            android:textColor="#111827"
            android:textSize="12sp" />

        <TextView
            android:id="@+id/overlay_time"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:fontFamily="monospace"
            android:fontFeatureSettings="tnum"
            android:text="00:00"
            android:textColor="#9CA3AF"
            android:textSize="10sp" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/overlay_detail"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:ellipsize="end"
            android:maxLines="2"
            android:text="等待模型…"
            android:textColor="#6B7280"
            android:textSize="10sp" />

        <TextView
            android:id="@+id/overlay_pause"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:layout_marginStart="8dp"
            android:background="@drawable/bg_agent_overlay_button"
            android:clickable="true"
            android:focusable="false"
            android:gravity="center"
            android:text="Ⅱ"
            android:textColor="#111827"
            android:textSize="11sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/overlay_stop"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:layout_marginStart="6dp"
            android:background="@drawable/bg_agent_overlay_stop"
            android:clickable="true"
            android:focusable="false"
            android:gravity="center"
            android:text="■"
            android:textColor="#E11D2E"
            android:textSize="10sp" />
    </LinearLayout>
</LinearLayout>
