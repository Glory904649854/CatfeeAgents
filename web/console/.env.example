# CatfeeAgents 控制台环境变量示例
# 复制为 .env 后修改；不要提交真实密码或密钥。

# 监听端口（单端口同时承载页面、API、SSE、Agent WebSocket）
PORT=9777

# 对外访问地址，用于展示 Agent 接入信息
NUXT_PUBLIC_URL=http://localhost:9777

# SQLite 数据库路径，相对于 web/console 目录
NUXT_DB_PATH=./data/catfee.db

# 首次启动时创建的管理员账号（仅当数据库为空时生效）
# 密码留空会在首次启动随机生成，并且只在启动日志里显示一次
NUXT_ADMIN_USER=admin
NUXT_ADMIN_PASSWORD=

# 控制台登录会话有效天数
NUXT_SESSION_DAYS=30
