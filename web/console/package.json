{
  "name": "@catfee/console",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@9.15.1",
  "engines": {
    "node": ">=22.21.0"
  },
  "description": "Catfee Agents web console: device, task and event management for authorized Android agents.",
  "scripts": {
    "dev": "node scripts/check-node.mjs && node node_modules/nuxt/bin/nuxt.mjs dev",
    "build": "node scripts/check-node.mjs && node node_modules/nuxt/bin/nuxt.mjs build",
    "preview": "node scripts/check-node.mjs && node node_modules/nuxt/bin/nuxt.mjs preview",
    "start": "node scripts/check-node.mjs && node scripts/start.mjs",
    "typecheck": "node scripts/check-node.mjs && node node_modules/nuxt/bin/nuxt.mjs typecheck",
    "db:reset": "node scripts/db-reset.mjs",
    "db:demo": "node scripts/check-node.mjs && node scripts/db-demo.mjs",
    "agent:sim": "node scripts/check-node.mjs && node scripts/agent-sim.mjs"
  },
  "dependencies": {
    "better-sqlite3": "^13.0.3",
    "naive-ui": "^2.45.3",
    "nuxt": "^4.6.4",
    "vue": "^3.5.45",
    "vue-router": "^5.4.0",
    "vuex": "^4.1.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@iconify-json/lucide": "^1.2.152",
    "@types/better-sqlite3": "^9.6.0",
    "@unocss/nuxt": "^66.12.0",
    "typescript": "^5.9.3",
    "unocss": "^66.12.0",
    "vue-tsc": "^3.3.14"
  }
}
